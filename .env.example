# Local DevTools (no Auth0). Tools still hit the website by DEV_USER_EMAIL.
MCP_AUTH_REQUIRED=false
SERVER_URL=http://localhost:3000
MCP_RESOURCE_URL=http://localhost:3000/mcp
WEBSITE_URL=http://localhost:5000
DEV_USER_EMAIL=you@mawsool.tech
CHATGPT_MCP_INTERNAL_SECRET=local-dev-chatgpt-secret

