# ChatGPT MCP

# Test in ChatGPT with no OAuth — user pastes api_key in chat (website login email):
MCP_AUTH_REQUIRED=false
SERVER_URL=https://chatgpt-mcp.example.com
MCP_RESOURCE_URL=https://chatgpt-mcp.example.com/mcp
WEBSITE_URL=https://backtest.mawsool.tech
CHATGPT_MCP_INTERNAL_SECRET=generate-a-long-random-secret

# Optional local DevTools fallback if you do not want to type api_key:
# DEV_USER_EMAIL=you@mawsool.tech

# Production ChatGPT Connect (Auth0) — set MCP_AUTH_REQUIRED=true and:
# AUTH_ISSUER=https://YOUR_TENANT.auth0.com/
# AUTH_AUDIENCE=https://chatgpt-mcp.example.com/mcp
