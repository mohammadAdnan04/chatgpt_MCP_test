# Search/enrichment proxy. Backend and MCP never talk to the engine directly.

PORT=3000
NODE_ENV=production

# Cache DB (can be the same Atlas cluster)
MONGO_URI=

# Optional: api.mawsool users/credits DB
# API_MAWSOOL_MONGO_URI=

# Shared with back_end MAWSOOL_MIDDLEWARE_KEY (x-api-key)
MAWSOOL_MIDDLEWARE_KEY=

# Search engine (people/company index)
MAWSOOL_ENGINE_URL=https://menasearch.mawsool.tech

# Website API (bulk jobs, hydrate callbacks)
BACKEND_URL=https://api.example.com
API_URL=https://api.example.com
INTERNAL_SECRET=

# Optional live enrichment
# API_CLUB_KEY=
# APIFY_API_KEY=
# CONTACTOUT_TOKEN=
